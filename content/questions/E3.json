[
  {
    "id": "q-E3-mtbe-flaw-001",
    "reactionId": "E3",
    "reactionIds": [
      "E3",
      "E4"
    ],
    "chapter": 17,
    "difficulty": 2,
    "orderTypes": [
      "spot_flaw"
    ],
    "flaw": {
      "target": {
        "smiles": "COC(C)(C)C",
        "name": "2-methoxy-2-methylpropane (tert-butyl methyl ether)"
      },
      "routes": [
        {
          "id": "A",
          "start": {
            "smiles": "CC(C)(C)O",
            "name": "2-methylpropan-2-ol"
          },
          "steps": [
            {
              "reagents": [
                "NaH"
              ]
            },
            {
              "reagents": [
                "CH3I"
              ]
            }
          ],
          "works": true,
          "reactionId": "E3",
          "product": {
            "smiles": "COC(C)(C)C",
            "stereo": "none"
          },
          "why": "tert-Butoxide is hindered but that does not matter for the nucleophile; CH₃I has no β-hydrogens and is a perfect SN2 electrophile."
        },
        {
          "id": "B",
          "start": {
            "smiles": "CO",
            "name": "methanol"
          },
          "steps": [
            {
              "reagents": [
                "NaH"
              ]
            },
            {
              "reagents": [
                "tBuBr"
              ]
            }
          ],
          "works": false,
          "reactionId": "E4",
          "product": {
            "smiles": "C=C(C)C",
            "stereo": "none"
          },
          "tag": "williamson_E2",
          "why": "Methoxide is a strong base and tert-butyl bromide is 3°: E2 wins and you get 2-methylpropene, not the ether. Put the bulky group on the alkoxide side and use CH₃I."
        }
      ],
      "choices": [
        {
          "tag": "williamson_E2",
          "label": "A 2°/3° halide with an alkoxide gives E2 (an alkene), not SN2"
        },
        {
          "tag": "aryl_SN2",
          "label": "SN2 can't happen on an aryl carbon"
        },
        {
          "tag": "lewis_acid_as_base",
          "label": "AlCl₃ is not a base, so no alkoxide forms"
        },
        {
          "tag": "wrong_reagent_order",
          "label": "The alkyl halide was added before the base"
        }
      ],
      "answer": {
        "route": "A",
        "tag": "williamson_E2"
      }
    },
    "explanation": "In a Williamson synthesis the alkoxide can be as hindered as you like, but the halide must be CH₃ or 1°. Route A pairs tert-butoxide with CH₃I (SN2 fine); route B pairs methoxide with a 3° bromide (E2).",
    "tip": "Bulky alkoxide, tiny halide. Never the other way round.",
    "source": "Carey 12e §17.6 (toolkit E3/E4)"
  },
