    "route": [
      {
        "reagent": "NaNO2_H2SO4",
        "conditions": {
          "temp": "ice"
        }
      },
      {
        "reagent": "H2O",
        "conditions": {
          "temp": "reflux"
        }
      }
    ],
    "traps": [
      {
        "smiles": "Cc1ccc(N)c([N+](=O)[O-])c1",
        "stereo": "none",
        "tag": "nitrite_vs_nitric",
        "why": "You nitrated the ring. NaNO₂/acid is nitrous acid, which reacts with the NH₂ group itself (diazotisation); it never adds NO₂ to a ring C–H. That needs HNO₃/H₂SO₄."
      },
      {
        "smiles": "Cc1ccc([N+]#N)cc1",
        "stereo": "none",
        "tag": "missing_workup",
        "why": "This is the diazonium salt, the intermediate after step 1. You still need H₂O and heat to replace N₂ with OH."
      },
      {
        "smiles": "Cc1ccc([N+](=O)[O-])cc1",
        "stereo": "none",
        "tag": "nitrite_vs_nitric",
        "why": "NH₂ was swapped for NO₂. Nitrous acid converts NH₂ into N₂⁺, which leaves as N₂ gas; the OH from water takes that carbon. NO₂ is never involved."
      }
    ],
    "nameTraps": [
      {
        "name": "methylphenol",
        "tag": "naming_locant",
        "why": "Which carbon? 4-methylphenol."
      }
    ],
    "explanation": "NaNO₂/H₂SO₄ at 0–5 °C converts the NH₂ into a diazonium group; H₂O and heat then replace N₂ with OH on the same carbon. The methyl group is untouched: 4-methylphenol.",
    "tip": "Nitrite, not nitric: NaNO₂ talks to the amine, HNO₃ talks to the ring.",
    "source": "Carey 12e §24 phenol prep via diazonium (toolkit P1); seeded Missed"
  },
