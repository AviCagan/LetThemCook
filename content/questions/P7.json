      "make_it"
    ],
    "start": {
      "smiles": "Oc1ccccc1",
      "name": "phenol"
    },
    "target": {
      "name": "phenyl acetate",
      "stereo": "none",
      "smiles": "CC(=O)Oc1ccccc1",
      "highlightAtoms": [
        0,
        1,
        2,
        3,
        4
      ]
    },
    "route": [
      {
        "reagent": "AcCl_pyr"
      }
    ],
    "altRoutes": [
      [
        {
          "reagent": "Ac2O"
        }
      ]
    ],
    "traps": [
      {
        "smiles": "CC(=O)c1ccc(O)cc1",
        "stereo": "none",
        "tag": "acyl_wrong_site",
        "why": "With AlCl₃ the acyl group goes on the ring (ketone). Without it, the phenol oxygen is acylated: an ester."
      },
      {
        "smiles": "COc1ccccc1",
        "stereo": "none",
        "tag": "acyl_wrong_site",
        "why": "That is an ether. An ester needs an acyl chloride or anhydride, not an alkyl halide."
      }
    ],
    "explanation": "Without a Lewis acid the phenol oxygen is the nucleophile: it attacks the acyl chloride / anhydride to give an aryl ester.",
    "tip": "No AlCl₃ → O-acylation → aryl ester."
  },
