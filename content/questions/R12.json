    ],
    "start": {
      "smiles": "CCCCO",
      "name": "butan-1-ol"
    },
    "target": {
      "name": "1-chlorobutane",
      "stereo": "none",
      "smiles": "CCCCCl",
      "highlightAtoms": [
        3,
        4
      ]
    },
    "route": [
      {
        "reagent": "SOCl2"
      }
    ],
    "traps": [
      {
        "smiles": "CCCCBr",
        "stereo": "none",
        "tag": "reagent_label_unknown",
        "why": "PBr₃ gives the bromide. For the chloride use SOCl₂ (or HCl/ZnCl₂)."
      },
      {
        "smiles": "CCCC=O",
        "stereo": "none",
        "tag": "reagent_label_unknown",
        "why": "PCC oxidises; you need a substitution of OH by Cl."
      }
    ],
    "explanation": "SOCl₂ converts the OH into a chlorosulfite leaving group; chloride then displaces it: R–Cl.",
    "tip": "SOCl₂ = alcohol to chloride."
  },
