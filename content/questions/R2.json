    "target": {
      "name": "1-phenylpent-4-en-1-ol",
      "stereo": "racemic",
      "altNames": [
        "1-phenyl-4-penten-1-ol"
      ],
      "stereoChoices": [
        "racemic",
        "single_enantiomer",
        "meso"
      ],
      "smiles": "C=CCCC(O)c1ccccc1",
      "highlightAtoms": [
        4,
        5
      ]
    },
    "route": [
      {
        "reagent": "NaBH4"
      }
    ],
    "traps": [
      {
        "smiles": "CCCC[C@H](O)c1ccccc1",
        "stereo": "racemic",
        "tag": "over_reduction",
        "why": "You reduced the C=C as well. NaBH₄ only delivers hydride to the polarised C=O; an isolated C=C is untouched. Getting both needs H₂/Pt."
      },
      {
        "smiles": "CCCCC(=O)c1ccccc1",
        "stereo": "none",
        "tag": "over_reduction",
        "why": "This reduced the wrong π bond. NaBH₄ is a hydride nucleophile and needs an electrophilic carbonyl carbon; it does not add to an isolated C=C at all."
      },
      {
        "smiles": "C=CCCC(=O)c1ccccc1",
        "stereo": "none",
        "tag": "reagent_label_unknown",
        "why": "NaBH₄ does react here: a ketone is exactly what it reduces. 'No reaction' would be right for an ester or an isolated alkene, not for a ketone."
      },
      {
        "smiles": "C=CCCCc1ccccc1",
        "stereo": "none",
        "tag": "reagent_label_unknown",
        "why": "Removing the oxygen completely is Clemmensen (Zn(Hg)/HCl) or Wolff–Kishner chemistry. A hydride adds H to the carbonyl carbon and leaves the oxygen behind as OH."
      }
    ],
    "nameTraps": [
      {
        "name": "1-phenylpent-4-en-ol",
        "tag": "naming_locant",
        "why": "The -ol needs its locant: 1-phenylpent-4-en-1-ol."
      },
      {
        "name": "5-phenylpent-1-en-5-ol",
        "tag": "naming_locant",
        "why": "Number from the end that gives the -ol the lowest locant: the OH is on C1, the alkene on C4."
      }
    ],
    "explanation": "NaBH₄ reduces the ketone to a 2° alcohol and leaves the isolated C=C alone. The carbinol carbon is a new stereocenter made from an achiral ketone, so the product is racemic.",
    "tip": "Mild hydride, one job: carbonyls only. The alkene is just along for the ride.",
    "source": "Carey 12e §16.2 (toolkit R2)"
  },
