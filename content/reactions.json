  {
    "id": "R10",
    "name": "Hydroboration–oxidation",
    "chapter": 16,
    "section": "alcohols",
    "phase": 1,
    "reagentsText": "1. BH₃·THF; 2. H₂O₂, NaOH",
    "steps": [
      {
        "reagents": [
          "BH3_THF"
        ]
      },
      {
        "reagents": [
          "H2O2_NaOH"
        ]
      }
    ],
    "rules": {
      "summary": "Anti-Markovnikov hydration: OH on the less substituted carbon, H and OH syn. New stereocenters → racemic.",
      "regio": "OH goes to the carbon with more hydrogens.",
      "stereo": "Syn addition: on a ring the OH is trans to the substituent that was on the other alkene carbon."
    },
    "stereoOutcome": "syn_racemic",
    "typicalTags": [
      "markovnikov_flip",
      "missing_stereo",
      "syn_anti_mixup",
      "missing_workup"
    ],
    "decoys": [
