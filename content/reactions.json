  {
    "id": "P1",
    "name": "Diazonium route to a phenol",
    "chapter": 16,
    "section": "phenols",
    "phase": 1,
    "reagentsText": "1. NaNO₂, H₂SO₄ (or HCl), 0–5 °C; 2. H₂O, heat",
    "steps": [
      {
        "reagents": [
          "NaNO2_H2SO4"
        ],
        "conditions": {
          "temp": "ice"
        }
      },
      {
        "reagents": [
          "H2O"
        ],
        "conditions": {
          "temp": "reflux"
        }
      }
    ],
    "rules": {
      "summary": "Ar–NH₂ → Ar–OH on the SAME carbon via the diazonium salt. NaNO₂ is not nitration (HNO₃ is the decoy).",
      "notes": [
        "Step 1 must be cold (0–5 °C) or the diazonium salt decomposes.",
        "Everything else on the ring stays where it is."
      ]
    },
    "stereoOutcome": "none",
    "smarts": [
      {
        "rxn": "[c:1][NX3H2]>>[c:1][OH]",
        "reactants": [
          "start"
        ],
        "mode": "single"
      }
    ],
    "decoys": [
