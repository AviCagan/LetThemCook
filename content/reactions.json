        "mode": "exhaustive"
      },
      {
        "rxn": "[C;!$(C(=O)[O,N,S,Cl,Br]):1]=[O:2]>>[C:1][O:2]",
        "reactants": [
          "start"
        ],
        "mode": "exhaustive"
      }
    ],
    "decoys": [
