    "stereoOutcome": "none",
    "smarts": [
      {
        "rxn": "[OX2H1:1][#6:2].[CX4;!$(C(C)C):3][Cl,Br,I]>>[#6:2][O:1][C:3]",
        "reactants": [
          "start",
          "step:2"
        ],
        "mode": "single"
      }
    ],
    "decoys": [
      "AlCl3",
      "tBuBr",
      "iPrBr",
      "NaOH"
    ],
    "typicalTags": [
      "williamson_E2",
      "lewis_acid_as_base",
      "wrong_reagent_order",
      "aryl_SN2",
      "reagent_label_unknown"
    ],
