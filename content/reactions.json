  {
    "id": "E3",
    "name": "Williamson ether synthesis",
    "chapter": 17,
    "section": "ethers",
    "phase": 1,
    "reagentsText": "1. NaH (or Na); 2. CH₃X / 1° RX",
    "steps": [
